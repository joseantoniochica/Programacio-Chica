# Números
n1 = int(input('Escriu un número\n'))
n2 = int(input('Escriu un segon número\n'))
suma = n1+n2

# Simplificació de l'if en una línia
#if (n1+n2 > 10): print('La seva suma és més gran que 10')

if (suma > 10): {
    print('La seva suma és més gran que 10')
}
else: {
    print('La seva suma és més petita que 10')
}

