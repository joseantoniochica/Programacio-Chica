# Operador or (o)
if (suma < 4 or suma > 8): {
    print('La seva suma és més petita que 4 o més gran que 8')
}

# Operador and (i)
if (suma > 12 and suma < 18): {
    print('La seva suma és més gran que 12 i més petita que 18')
}

