    intent += 1
    print(f'\033[1mTaulell  {intent:<2}\033[0m: ','_','_','_','_')
    for i in range(4):
        print(f"\033[F\033[{13+i*2}C", end="") # Per sobreescriure el taulell. Puja i es desplaça
